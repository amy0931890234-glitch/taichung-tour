      </Placemark>
      <Placemark>
        <name>Corning Museum of Glass</name>
        <description>世界頂級康寧玻璃藝術博物館與吹玻璃表演</description>
        <Point>
          <coordinates>-77.0543,42.1432,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Watkins Glen State Park Gorge Trail</name>
        <description>五指湖最震撼的 19 座瀑布峽谷步道</description>
        <Point>
          <coordinates>-76.8732,42.3756,0</coordinates>
        </Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>🌊 Day 7-11 綺色佳, 尼加拉瀑布 &amp; 匹茲堡</name>
      <Placemark>
        <name>Taughannock Falls State Park</name>
        <description>落差達 65 公尺（超越尼加拉瀑布單體落差）的高空瀑布</description>
        <Point>
          <coordinates>-76.6001,42.5358,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Cornell University (康乃爾大學)</name>
        <description>藤校校園巡禮、McGraw Tower 與峽谷吊橋</description>
        <Point>
          <coordinates>-76.4735,42.4534,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Letchworth State Park (美東大峽谷)</name>
        <description>美東大峽谷壯麗三層大瀑布奇觀</description>
        <Point>
          <coordinates>-77.9744,42.5701,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Niagara Falls State Park</name>
        <description>霧中少女號 (Maid of the Mist) 與風之洞 (Cave of the Winds)</description>
        <Point>
          <coordinates>-79.0642,43.0815,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Top of the Falls Restaurant</name>
        <description>全美唯一座落於馬蹄瀑布旁的全景美景餐廳</description>
        <Point>
          <coordinates>-79.0689,43.0822,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Presque Isle State Park (Erie)</name>
        <description>伊利湖天然沙洲半島與夕陽觀景台</description>
        <Point>
          <coordinates>-80.1118,42.1601,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Duquesne Incline (匹茲堡纜車)</name>
        <description>百年復古纜車，登頂俯瞰三河交會夜景</description>
        <Point>
          <coordinates>-80.0181,40.4398,0</coordinates>
        </Point>
      </Placemark>
    </Folder>
