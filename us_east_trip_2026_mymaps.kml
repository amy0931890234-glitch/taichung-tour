<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>2026 美東 17 天自然與建築自駕公路旅行</name>
    <description>包含景點、飯店、美景與自駕據點標記，可直接匯入 Google 我的地圖 (Google My Maps)</description>
    <Folder>
      <name>🏨 住宿飯店與據點</name>
      <Placemark>
        <name>Hyatt Regency Reston (Base 1)</name>
        <description>Day 1-3 住宿據點，交通生活機能優良</description>
        <Point>
          <coordinates>-77.357,38.9587,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Skyland Lodge (Shenandoah)</name>
        <description>Day 3 仙納度國家公園小木屋，位於 Skyline Drive 最佳觀星點</description>
        <Point>
          <coordinates>-78.3809,38.5921,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>The George Washington Hotel</name>
        <description>Day 4 溫徹斯特歷史風格飯店</description>
        <Point>
          <coordinates>-78.1636,39.1843,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Hyatt Place State College</name>
        <description>Day 5 賓州州立大學城飯店</description>
        <Point>
          <coordinates>-77.86,40.7934,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Watkins Glen Harbor Hotel</name>
        <description>Day 6-7 塞內卡湖畔五星級湖景飯店</description>
        <Point>
          <coordinates>-76.8725,42.3812,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Hyatt Place Niagara Falls</name>
        <description>Day 8 步行至尼加拉瀑布公園僅 5 分鐘</description>
        <Point>
          <coordinates>-79.0614,43.0858,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>The Industrialist Hotel Pittsburgh</name>
        <description>Day 9 匹茲堡市中心精品歷史飯店</description>
        <Point>
          <coordinates>-79.9959,40.4406,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Penn Wells Hotel</name>
        <description>Day 10 落水山莊周邊特色旅宿</description>
        <Point>
          <coordinates>-77.2964,41.7476,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Residence Inn Rosslyn Arlington</name>
        <description>Day 11-16 華盛頓DC據點，附廚房與便利停車</description>
        <Point>
          <coordinates>-77.0712,38.8951,0</coordinates>
        </Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>🚗 Day 1-3 華盛頓DC &amp; 仙納度公園</name>
      <Placemark>
        <name>Washington Dulles Airport (IAD)</name>
        <description>起飛與降落國際機場，取車還車地點</description>
        <Point>
          <coordinates>-77.4565,38.9531,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Silver Diner Reston</name>
        <description>美式夜宵與熱牛肉湯餐廳</description>
        <Point>
          <coordinates>-77.3601,38.9542,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Great Falls Park (大瀑布國家公園)</name>
        <description>波托馬克河巨石瀑布奇景與 Billy Goat Trail</description>
        <Point>
          <coordinates>-77.2541,38.9986,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Skyline Drive Thornton Gap Entrance</name>
        <description>仙納度國家公園全景景觀道路入口</description>
        <Point>
          <coordinates>-78.3211,38.6607,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Stony Man Trail Summit Overlook</name>
        <description>輕鬆步道，俯瞰藍嶺山脈絕美落日</description>
        <Point>
          <coordinates>-78.3734,38.5982,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Old Rag Mountain Trailhead</name>
        <description>傳奇花崗岩巨石攀爬健行峰頂</description>
